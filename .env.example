# RPC endpoint for the target Stellar/Soroban network.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban-mainnet.stellar.org (or a private node)
SOROBAN_RPC_URL=https://your-rpc-endpoint.example.com

# Network passphrase identifies which Stellar network you are targeting.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
SOROBAN_NETWORK_PASSPHRASE=your-network-passphrase-here

# Friendly network name used by Soroban CLI (e.g. testnet, mainnet, standalone)
SOROBAN_NETWORK=testnet

# The Stellar account that signs and pays for deployment transactions.
DEPLOYER_ACCOUNT=your-deployer-account-name-or-address

# Secret key for the deployer account (used in CI via GitHub Secrets).
# Generate with: soroban keys generate <name>
# NEVER commit the real value here.
DEPLOYER_SECRET_KEY=S000000000000000000000000000000000000000000000000000000

# Populated after first deployment. Used by initialize.sh and future scripts.
CREDENTIAL_REGISTRY_CONTRACT_ID=your-contract-id-after-deployment


IPFS_GATEWAY=https://ipfs.io/ipfs/

# (Optional) Pinning service API key — e.g. Pinata, Web3.Storage
IPFS_PINNING_API_KEY=your-ipfs-pinning-api-key